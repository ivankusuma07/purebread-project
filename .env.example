# Copy to .env.local for local work. Never commit real keys.

# --- Site (Vercel) -----------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://veracity.vercel.app"
# Robinhood Chain mainnet (4663). Confirm both against the Robinhood Chain docs.
NEXT_PUBLIC_RPC_URL="https://rpc.chain.robinhood.com"
NEXT_PUBLIC_EXPLORER_URL="https://robinscan.io"

# Token and fee router. Leave empty until each exists: the /fee-router page
# stays in preview mode (banner on, figures labelled "sample", calls simulated)
# until both the router and the vault are set.
NEXT_PUBLIC_TOKEN_ADDRESS=""
NEXT_PUBLIC_POOL_ADDRESS=""
NEXT_PUBLIC_CREATOR_ADDRESS=""
NEXT_PUBLIC_ROUTER_ADDRESS=""
NEXT_PUBLIC_VAULT_ADDRESS=""
NEXT_PUBLIC_DATA_WALLET_ADDRESS=""
NEXT_PUBLIC_LAUNCHPAD_URL=""

# Footer links, shown only when set.
NEXT_PUBLIC_GITHUB_URL=""
NEXT_PUBLIC_X_URL=""

# --- Monthly job (Railway cron) ---------------------------------------------
# Ingest. Absent means lookups stay null, by design.
BITQUERY_API_KEY=""
EXPLORER_API_URL=""

# AI review (OpenAI-compatible, temperature 0). Absent means scores carry unchanged.
LLM_API_URL=""
LLM_API_KEY=""
LLM_MODEL=""

# Push access for the job's commit (fine-grained token, contents:write on this repo only).
GITHUB_TOKEN=""
